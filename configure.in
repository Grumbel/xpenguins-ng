AC_INIT(src/main.c)
AM_INIT_AUTOMAKE(xpenguins,2.2)
AM_CONFIG_HEADER(config.h)

dnl Checks for programs.
AC_PROG_CC
AC_PROG_INSTALL

AC_PATH_X
AC_PATH_XTRA

XPENGUINS_CFLAGS="$X_CFLAGS $CFLAGS"

LIBS="$X_LIBS -lX11 -lXext"

AC_CHECK_LIB(Xpm, XpmReadFileToData,, \
	AC_MSG_ERROR(Valid xpm library not found),$LIBS)
AC_CHECK_LIB(Xpm, XpmFree,, \
	AC_MSG_ERROR(Valid xpm library not found),$LIBS)

dnl Checks for header files.
AC_HEADER_STDC
AC_CHECK_HEADERS(unistd.h)

dnl Checks for typedefs, structures, and compiler characteristics.
AC_HEADER_TIME

dnl Checks for library functions.
AC_TYPE_SIGNAL
AC_CHECK_FUNCS(select strdup)

AC_SUBST(XPENGUINS_CFLAGS)

AC_OUTPUT(Makefile src/Makefile themes/Makefile themes/Penguins/Makefile themes/Big_Penguins/Makefile themes/Classic_Penguins/Makefile themes/Turtles/Makefile themes/Bill/Makefile xpenguins.spec)
